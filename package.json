{
  "name": "ostv",
  "displayName": "OSTV",
  "description": "Chat with a headless opencode server, view AI file changes with native VS Code diff",
  "version": "0.3.1",
  "publisher": "mmmiiiaaoo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:ostv.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ostv",
          "title": "opencode",
          "icon": "$(symbol-event)",
          "when": "!terminalFocus"
        }
      ]
    },
    "views": {
      "ostv": [
        {
          "id": "ostv.chat",
          "name": "Chat",
          "type": "webview",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "ostv.newSession",
        "title": "opencode: New Session",
        "icon": "$(add)"
      },
      {
        "command": "ostv.focus",
        "title": "opencode: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ostv.startServer",
        "title": "opencode: Start Server (One-Click)",
        "icon": "$(play)"
      },
      {
        "command": "ostv.checkStatus",
        "title": "opencode: Check Server Status",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ostv.newSession",
          "when": "view == ostv.chat",
          "group": "navigation"
        },
        {
          "command": "ostv.startServer",
          "when": "view == ostv.chat",
          "group": "navigation"
        },
        {
          "command": "ostv.checkStatus",
          "when": "view == ostv.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "OSTV",
      "properties": {
        "ostv.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4096",
          "description": "Base URL of the headless opencode server"
        },
        "ostv.username": {
          "type": "string",
          "default": "opencode",
          "description": "Basic auth username (OPENCODE_SERVER_USERNAME)"
        },
        "ostv.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "Basic auth password (OPENCODE_SERVER_PASSWORD). Leave empty to read from the OPENCODE_SERVER_PASSWORD environment variable."
        },
        "ostv.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default model, e.g. `opencode/big-pickle` (providerID/modelID). Empty = server default."
        },
        "ostv.opencodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the opencode executable (`opencode.exe`). Leave empty to auto-detect (Windows: `C:\\Users\\<user>\\AppData\\Roaming\\npm\\node_modules\\opencode-ai\\bin\\opencode.exe`)."
        },
        "ostv.disabledModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "模型列表中禁用的模型（providerID/modelID），可在聊天面板的模型管理中切换"
        },
        "ostv.uiLanguage": {
          "type": "string",
          "enum": [
            "plain",
            "pro"
          ],
          "enumDescriptions": [
            "白话：通俗易懂的中文说明",
            "专业：中文 + 英文术语，贴近开发者"
          ],
          "default": "plain",
          "description": "界面文案风格：白话 / 专业"
        },
        "ostv.showReasoning": {
          "type": "boolean",
          "default": true,
          "description": "是否显示 AI 的思考过程（reasoning 部分），关闭后折叠"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.102.0",
    "typescript": "^5.6.0"
  }
}
