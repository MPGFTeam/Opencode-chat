{
  "name": "opencode-chat",
  "displayName": "opencode chat",
  "description": "Chat with a headless opencode server, view AI file changes with native VS Code diff",
  "version": "0.2.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Chat"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:opencodeChat.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeChat",
          "title": "opencode",
          "icon": "$(symbol-event)",
          "when": "!terminalFocus"
        }
      ]
    },
    "views": {
      "opencodeChat": [
        {
          "id": "opencodeChat.chat",
          "name": "Chat",
          "type": "webview",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeChat.newSession",
        "title": "opencode: New Session",
        "icon": "$(add)"
      },
      {
        "command": "opencodeChat.focus",
        "title": "opencode: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodeChat.startServer",
        "title": "opencode: Start Server (One-Click)",
        "icon": "$(play)"
      },
      {
        "command": "opencodeChat.checkStatus",
        "title": "opencode: Check Server Status",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeChat.newSession",
          "when": "view == opencodeChat.chat",
          "group": "navigation"
        },
        {
          "command": "opencodeChat.startServer",
          "when": "view == opencodeChat.chat",
          "group": "navigation"
        },
        {
          "command": "opencodeChat.checkStatus",
          "when": "view == opencodeChat.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "opencode chat",
      "properties": {
        "opencodeChat.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4096",
          "description": "Base URL of the headless opencode server"
        },
        "opencodeChat.username": {
          "type": "string",
          "default": "opencode",
          "description": "Basic auth username (OPENCODE_SERVER_USERNAME)"
        },
        "opencodeChat.password": {
          "type": "string",
          "default": "",
          "markdownDescription": "Basic auth password (OPENCODE_SERVER_PASSWORD). Leave empty to read from the OPENCODE_SERVER_PASSWORD environment variable."
        },
        "opencodeChat.defaultModel": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default model, e.g. `opencode/big-pickle` (providerID/modelID). Empty = server default."
        },
        "opencodeChat.opencodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the opencode executable (`opencode.exe`). Leave empty to auto-detect (Windows: `C:\\Users\\<user>\\AppData\\Roaming\\npm\\node_modules\\opencode-ai\\bin\\opencode.exe`)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.102.0",
    "typescript": "^5.6.0"
  }
}